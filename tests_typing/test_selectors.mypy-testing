import attrs
import pytest

from web_poet import (
    HttpResponse,
    SelectorGroup,
    WebPage,
    css_get,
    css_getall,
    field,
    xpath_get,
    xpath_getall,
)


class SkuSelectors(SelectorGroup):
    meta = xpath_get("//meta[@itemprop='sku']/@content")
    texts = css_getall(".sku::text")


@attrs.define
class Page(WebPage):
    name = field(css_get("h1::text"))
    brand = field(xpath_get("//meta[@itemprop='brand']/@content"))
    images = field(css_getall("img::attr(src)"))
    sources = field(xpath_getall("//img/@src"))
    length = field(css_get("h1::text"), out=[len])

    helper = css_get(".sku::text")
    helpers = css_getall(".sku::text")
    skus = SkuSelectors()


@pytest.mark.mypy_testing
def test_field_css() -> None:
    page = Page(response=HttpResponse("http://example.com", b""))
    reveal_type(page.name)  # R: str | None


@pytest.mark.mypy_testing
def test_field_xpath() -> None:
    page = Page(response=HttpResponse("http://example.com", b""))
    reveal_type(page.brand)  # R: str | None


@pytest.mark.mypy_testing
def test_field_css_all() -> None:
    page = Page(response=HttpResponse("http://example.com", b""))
    reveal_type(page.images)  # R: list[str]


@pytest.mark.mypy_testing
def test_field_xpath_all() -> None:
    page = Page(response=HttpResponse("http://example.com", b""))
    reveal_type(page.sources)  # R: list[str]


@pytest.mark.mypy_testing
def test_declaration() -> None:
    page = Page(response=HttpResponse("http://example.com", b""))
    reveal_type(page.helper)  # R: str | None


@pytest.mark.mypy_testing
def test_declaration_all() -> None:
    page = Page(response=HttpResponse("http://example.com", b""))
    reveal_type(page.helpers)  # R: list[str]


@pytest.mark.mypy_testing
def test_group() -> None:
    page = Page(response=HttpResponse("http://example.com", b""))
    reveal_type(page.skus)  # R: __main__.SkuSelectors
    reveal_type(page.skus.meta)  # R: str | None
    reveal_type(page.skus.texts)  # R: list[str]


@pytest.mark.mypy_testing
@pytest.mark.xfail(reason="mypy does not infer field(out=...) transformed return type")
def test_field_out() -> None:
    page = Page(response=HttpResponse("http://example.com", b""))
    reveal_type(page.length)  # R: int
